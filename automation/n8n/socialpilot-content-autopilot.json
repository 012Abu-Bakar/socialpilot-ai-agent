{
  "name": "SocialPilot – Weekly content autopilot",
  "nodes": [
    {
      "parameters": {},
      "id": "a1f0c1d2-0001-4000-8000-000000000001",
      "name": "Run now",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [0, 0]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            { "field": "weeks", "triggerAtDay": [1], "triggerAtHour": 9 }
          ]
        }
      },
      "id": "a1f0c1d2-0002-4000-8000-000000000002",
      "name": "Every Monday 09:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 200]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "c0000001", "name": "baseUrl", "value": "https://socialpilot-ai-lsbt.onrender.com", "type": "string" },
            { "id": "c0000002", "name": "email", "value": "demo@socialpilot.test", "type": "string" },
            { "id": "c0000003", "name": "password", "value": "CHANGE_ME", "type": "string" },
            { "id": "c0000004", "name": "brand", "value": "SocialPilot Demo", "type": "string" },
            { "id": "c0000005", "name": "topics", "value": "How small teams plan a week of content in one hour\nThree ways to repurpose one LinkedIn post\nWhat an approval workflow saves a marketing team", "type": "string" }
          ]
        },
        "options": {}
      },
      "id": "a1f0c1d2-0003-4000-8000-000000000003",
      "name": "Settings",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [240, 100]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.baseUrl }}/api/auth/login",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ email: $json.email, password: $json.password }) }}",
        "options": {
          "response": { "response": { "fullResponse": true } }
        }
      },
      "id": "a1f0c1d2-0004-4000-8000-000000000004",
      "name": "Sign in to SocialPilot",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [480, 100]
    },
    {
      "parameters": {
        "jsCode": "// One item per topic, each carrying the session cookie from the sign-in response.\nconst settings = $('Settings').first().json;\nconst login = $input.first().json;\nconst setCookie = [].concat(login.headers['set-cookie'] || []);\nconst cookie = setCookie.map(c => c.split(';')[0]).find(c => c.startsWith('sp_session='));\nif (!cookie) throw new Error('Sign-in did not return a session cookie');\nconst platforms = ['LinkedIn', 'Instagram'];\nreturn settings.topics.split('\\n').map(t => t.trim()).filter(Boolean).map((topic, i) => ({\n  json: { topic, platform: platforms[i % platforms.length], brand: settings.brand, baseUrl: settings.baseUrl, cookie, business: login.body.business.name },\n}));"
      },
      "id": "a1f0c1d2-0005-4000-8000-000000000005",
      "name": "Split topics",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [720, 100]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.baseUrl }}/api/generate",
        "sendHeaders": true,
        "headerParameters": { "parameters": [ { "name": "Cookie", "value": "={{ $json.cookie }}" } ] },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ topic: $json.topic, brand: $json.brand, platform: $json.platform, tone: 'Professional', objective: 'Engagement', variations: 2 }) }}",
        "options": {}
      },
      "id": "a1f0c1d2-0006-4000-8000-000000000006",
      "name": "Generate content",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [960, 100]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Split topics').item.json.baseUrl }}/api/drafts",
        "sendHeaders": true,
        "headerParameters": { "parameters": [ { "name": "Cookie", "value": "={{ $('Split topics').item.json.cookie }}" } ] },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ title: 'n8n · ' + $('Split topics').item.json.topic, content: $json.content, platform: $('Split topics').item.json.platform, topic: $('Split topics').item.json.topic }) }}",
        "options": {}
      },
      "id": "a1f0c1d2-0007-4000-8000-000000000007",
      "name": "Save as draft",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1200, 100]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Split topics').item.json.baseUrl }}/api/drafts/{{ $json.id }}/submit",
        "sendHeaders": true,
        "headerParameters": { "parameters": [ { "name": "Cookie", "value": "={{ $('Split topics').item.json.cookie }}" } ] },
        "options": {}
      },
      "id": "a1f0c1d2-0008-4000-8000-000000000008",
      "name": "Submit for approval",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1440, 100]
    },
    {
      "parameters": {
        "jsCode": "// One summary item: what the run created and where it is waiting.\nconst drafts = $input.all().map(i => i.json);\nreturn [{ json: {\n  business: $('Split topics').first().json.business,\n  drafts_submitted: drafts.length,\n  waiting_for_approval: drafts.map(d => `${d.platform}: ${d.title}`),\n  credits_used: $('Generate content').all().reduce((sum, i) => sum + i.json.credits_used, 0),\n  next_step: 'An approver reviews these in the SocialPilot approval queue, then schedules them.',\n} }];"
      },
      "id": "a1f0c1d2-0009-4000-8000-000000000009",
      "name": "Run summary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1680, 100]
    }
  ],
