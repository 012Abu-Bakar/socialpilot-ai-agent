# Demo mode (default). Set to 0 AND provide ANTHROPIC_API_KEY to call the real AI provider.
SOCIALPILOT_MOCK_MODE=1
ANTHROPIC_API_KEY=your_claude_api_key_here
ANTHROPIC_MODEL=claude-haiku-5-5

# Optional
# SOCIALPILOT_DB=./socialpilot.db
# SOCIALPILOT_ALLOWED_HOSTS=localhost,127.0.0.1
# SOCIALPILOT_RATE_LIMIT=30   # generate/automation-run requests per minute per client
